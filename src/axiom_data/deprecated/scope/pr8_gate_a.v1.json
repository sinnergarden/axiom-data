  "historical_view_policy": {
    "anchor": "last_eligible_target_session_per_security.v1",
    "view_kinds": [
      "adjusted_price",
      "market_replay",
      "market_qlib",
      "pr6_fact",
      "pr7_fact"
    ],
    "scope": "retain_complete_requested_target; report_uncovered_intervals",
    "gap_admission": "requires_source_evidence; no_automatic_waiver",
    "fact_pit_policy": "best_effort_vendor_v1",
    "qlib_price_basis": "unadjusted",
    "adjusted_pit_policy": "research_non_pit"
  },
  "terminal_evidence": {
    "baseline": {
      "required": [
        "snapshot_id",
        "manifest_digest",
        "target_digest"
      ],
      "producer": "axiom_data.operations.bootstrap",
      "validator": "axiom_data.artifacts.load_snapshot",
      "calls": {
        "producer": {
          "args": [
            "$data_root"
          ],
          "kwargs": {
            "run_id": "$run_id",
            "domain_commit_ids": "$domain_commit_ids"
          }
        },
        "validator": {
          "args": [
            "$data_root",
            "$baseline.snapshot_id"
          ],
          "kwargs": {}
        }
      }
    },
    "views": {
      "required": [
        "snapshot_id",
        "target_digest",
        "refs"
      ],
      "producer": "axiom_data.view_operation.materialize_views",
      "validator": "axiom_data.gate_a.validate_terminal_evidence",
      "calls": {
        "producer": {
          "args": [
            "$data_root"
          ],
          "kwargs": {
            "run_id": "$run_id",
            "snapshot_id": "$baseline.snapshot_id",
            "views": "$view_execution_plan"
          }
        },
        "validator": {
          "args": [
            "$data_root",
            "$all_terminal_evidence"
          ],
          "kwargs": {
            "plan": "$terminal_evidence_plan"
          }
        }
      }
    },
    "full_admission": {
      "required": [
        "snapshot_id",
        "target_digest",
        "scope_registry_digest",
        "requirements",
        "features",
        "source_evidence_refs"
      ],
      "producer": "axiom_data.full_admission.full_admission",
      "validator": "axiom_data.full_admission.validate_full_admission",
      "calls": {
        "producer": {
          "args": [
            "$data_root"
          ],
          "kwargs": {
            "run_id": "$run_id",
            "snapshot_id": "$baseline.snapshot_id",
            "plan": "$full_admission_plan"
          }
        },
        "validator": {
          "args": [
            "$data_root",
            "$full_admission"
          ],
          "kwargs": {
            "expected_views": "$views.refs",
            "target_digest": "$target_digest"
          }
        }
      }
    },
    "daily": {
      "required": [
        "baseline_snapshot_id",
        "cases"
      ],
      "producer": "axiom_data.operations.daily",
      "validator": "axiom_data.daily_acceptance.validate_daily_evidence",
      "calls": {
        "producer": {
          "args": [
            "$data_root"
          ],
          "kwargs": {
            "run_id": "$run_id",
            "snapshot_id": "$baseline.snapshot_id",
            "source_requests": "$source_requests",
            "domain_inputs": "$domain_inputs"
          }
        },
        "validator": {
          "args": [
            "$data_root",
            "$daily"
          ],
          "kwargs": {
            "expected_baseline": "$baseline.snapshot_id"
          }
        }
      }
    },
    "recovery": {
      "required": [
        "snapshot_id",
        "snapshot_manifest_digest",
        "validated_views",
        "blocked_external_attempts",
        "restored_root",
        "run_id",
        "content_digest"
      ],
      "producer": "axiom_data.recovery.verify_recovery",
      "validator": "axiom_data.gate_a.validate_terminal_evidence",
      "calls": {
        "producer": {
          "args": [
            "$restored_root"
          ],
          "kwargs": {
            "run_id": "$run_id",
            "snapshot_id": "$baseline.snapshot_id",
            "expected_snapshot_manifest_digest": "$baseline.manifest_digest",
            "views": "$views.refs"
          }
        },
        "validator": {
          "args": [
            "$data_root",
            "$all_terminal_evidence"
          ],
          "kwargs": {
            "plan": "$terminal_evidence_plan"
          }
        }
      }
    },
    "notebook": {
      "required": [
        "snapshot_id",
        "view_refs",
        "target_digest",
        "executed_notebook_path",
        "content_digest",
        "parameters"
      ],
      "producer": "axiom_data.notebook_acceptance.execute_notebook_smoke",
      "validator": "axiom_data.notebook_acceptance.validate_notebook_smoke",
      "calls": {
        "producer": {
          "args": [
            "$data_root"
          ],
          "kwargs": {
            "snapshot_id": "$baseline.snapshot_id",
            "views": "$views.refs",
            "target": "$full_target",
            "output_path": "$executed_notebook_path"
          }
        },
        "validator": {
          "args": [
            "$data_root",
            "$notebook"
          ],
          "kwargs": {
            "expected_views": "$views.refs"
          }
        }
      }
    }
  },
  "daily_cases": [
    "t_plus_1",
