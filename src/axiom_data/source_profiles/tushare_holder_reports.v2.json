{
  "profile_version": "tushare_holder_reports.v2",
  "historical_qualification": "best_effort",
  "endpoints": {
    "stk_holdernumber": {
      "domain": "holder_count_events",
      "fields": [
        "ts_code",
        "ann_date",
        "end_date",
        "holder_num"
      ],
      "mapping": {
        "holder_num": [
          "number",
          1,
          "count"
        ]
      },
      "bound_field": "ann_date",
      "limit": 3000,
      "documentation": "https://tushare.pro/document/2?doc_id=166"
    }
  },
  "scope": "SSE/SZSE holder-count observations; timestamp-format extension only.",
  "announcement_format": {
    "accepted": [
      "YYYYMMDD",
      "YYYY-MM-DD HH:MM:SS"
    ],
    "timezone": "Asia/Shanghai",
    "precision": "Date-only uses session close; full timestamp retains supplier time as best-effort vendor availability. Raw is unchanged."
  }
}
