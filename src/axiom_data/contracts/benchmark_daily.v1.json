{
  "contract_version": "benchmark_daily.v1",
  "domain": "benchmark_daily",
  "primary_key": ["session", "benchmark"],
  "sort_order": ["session", "benchmark"],
  "semantics": {"price_basis": "unadjusted canonical index close", "identity": "canonical Tushare index code"},
  "fields": [
    {"name": "session", "type": "date", "nullable": false, "unit": "Asia/Shanghai exchange session"},
    {"name": "benchmark", "type": "string", "nullable": false, "unit": "canonical index code"},
    {"name": "close", "type": "float64", "nullable": false, "unit": "unadjusted index points"},
    {"name": "source_available_at", "type": "datetime", "nullable": true, "unit": "timezone-aware"},
    {"name": "first_observed_at", "type": "datetime", "nullable": false, "unit": "timezone-aware"},
    {"name": "availability_basis", "type": "string", "nullable": false, "unit": null},
    {"name": "pit_qualification", "type": "string", "nullable": false, "unit": null},
    {"name": "source_ref", "type": "string", "nullable": false, "unit": null}
  ],
  "validation": ["close is finite and non-negative", "session belongs to the fixed exchange calendar"]
}
